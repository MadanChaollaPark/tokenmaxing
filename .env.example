NEXT_PUBLIC_REPO_URL=https://github.com/MadanChaollaPark/tokenmaxing

# Required for public deploys.
DATABASE_URL=postgres://user:password@host:5432/tokenmaxing?sslmode=require
TOKENMAXING_SESSION_SECRET=replace-with-a-long-random-string

# GitHub OAuth app callback:
# https://your-domain.com/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional. Leave false in production.
TOKENMAXING_ALLOW_LOCAL_LOGIN=false
TOKENMAXING_ALLOW_LOCAL_SUBMIT=false

# Optional shared token for collector posts to /api/usage/ingest.
TOKENMAXING_INGEST_TOKEN=
